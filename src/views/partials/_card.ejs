<%
    // Define data for winner users/testimonials directly in this partial
    const testimonials = [
        {
            name: 'Alice Johnson',
            address: 'New York, USA',
            review: 'Absolutely love my new Bikesceeme bike! The ride is incredibly smooth, and the customer service was fantastic. Highly recommend!',
            stars: 5,
            imageUrl: '/images/alexander-hipp-iEEBWgY_6lA-unsplash.jpg'
        },
        {
            name: 'Bob Williams',
            address: 'London, UK',
            review: 'Bikesceeme made my dream custom bike a reality. The attention to detail is superb. This is the best bike I\'ve ever owned!',
            stars: 4,
            imageUrl: '/images/michael-dam-mEZ3PoFGs_k-unsplash.jpg'
        },
        {
            name: 'Carol Davis',
            address: 'Sydney, AUS',
            review: 'Great selection of urban bikes and very durable. Perfect for my daily commute. I\'m extremely satisfied with my purchase!',
            stars: 5,
            imageUrl: '/images/jordi-espinosa-5bJBFSIB3ac-unsplash.jpg'
        }
    ];
%>

<!-- Testimonials Section (for winner users) -->
<section class="testimonials-section">
    <h2>What Our Customers Say</h2>
    <div class="testimonials-container">
        <% testimonials.forEach(function(testimonial) { %>
            <div class="testimonial-card">
                <img src="<%= testimonial.imageUrl %>" alt="<%= testimonial.name %>" class="testimonial-image">
                <h3><%= testimonial.name %></h3>
                <p class="testimonial-address"><%= testimonial.address %></p>
                <div class="star-rating">
                    <% for (let i = 0; i < testimonial.stars; i++) { %>
                        <span class="star filled">&#9733;</span> <!-- Filled star (HTML entity for black star) -->
                    <% } %>
                    <% for (let i = 0; i < (5 - testimonial.stars); i++) { %>
                        <span class="star">&#9734;</span> <!-- Empty star (HTML entity for outline star) -->
                    <% } %>
                </div>
                <p class="testimonial-review">"<%= testimonial.review %>"</p>
            </div>
        <% }); %>
    </div>
</section>